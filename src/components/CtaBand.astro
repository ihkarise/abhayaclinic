---
import WhatsAppButton from '@components/WhatsAppButton.astro';
import CallButton from '@components/CallButton.astro';

interface Props {
  heading?: string;
  text?: string;
  /** Condition title to build a context-specific WhatsApp message. */
  condition?: string;
  waLabel?: string;
}

const {
  heading = 'Have an allergy concern?',
  text = 'Start a conversation on WhatsApp — ask about an in-person or online consultation with Dr Varun Vasudev.',
  condition,
  waLabel = 'Chat on WhatsApp',
} = Astro.props;
---

<section class="container-x my-20">
  <div class="rounded-3xl bg-primary px-6 py-12 text-center text-white sm:px-12">
    <h2 class="font-heading text-2xl font-bold sm:text-3xl text-white">{heading}</h2>
    <p class="mx-auto mt-3 max-w-2xl text-white/85">{text}</p>
    <div class="mt-7 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <WhatsAppButton context="booking" condition={condition} label={waLabel} size="lg" />
      <CallButton variant="outline" class="!border-white !text-white hover:!bg-white hover:!text-primary" />
    </div>
  </div>
</section>
