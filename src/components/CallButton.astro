---
import { clinic } from '@data/clinic';

interface Props {
  label?: string;
  variant?: 'solid' | 'outline' | 'ghost';
  class?: string;
}
const { label, variant = 'outline', class: className = '' } = Astro.props;

const base = 'btn px-5 py-2.5 text-sm transition-colors';
const variants = {
  solid: 'bg-primary text-white hover:bg-primary-dark',
  outline: 'border-2 border-primary text-primary hover:bg-primary hover:text-white',
  ghost: 'text-primary hover:bg-soft',
};
---

<a href={`tel:${clinic.phone.tel}`} class={`${base} ${variants[variant]} ${className}`}>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.9.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92Z" />
  </svg>
  {label ?? clinic.phone.display}
</a>
