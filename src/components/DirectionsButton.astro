---
import { clinic } from '@data/clinic';

interface Props {
  label?: string;
  class?: string;
}
const { label = 'Get Directions', class: className = '' } = Astro.props;
---

<a
  href={clinic.maps.directionsUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`btn px-5 py-2.5 text-sm text-primary hover:bg-soft transition-colors ${className}`}
>
  <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0Z" />
    <circle cx="12" cy="10" r="3" />
  </svg>
  {label}
</a>
