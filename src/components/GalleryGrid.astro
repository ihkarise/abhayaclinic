---
/**
 * Gallery grid + category filtering (Phase 3C — M2) + accessible lightbox (M3).
 *
 * Server-renders every gallery image (discovery never depends on JavaScript)
 * and progressively enhances:
 *   - the category chips into working filters (M2), and
 *   - each image into a trigger that opens a native <dialog> lightbox (M3).
 *
 * The Phase 3B media foundation is reused, not modified: images come from
 * `getGalleryPhotos()` and each item's category is derived at build time via
 * the Milestone 1 model in `src/lib/gallery.ts`. The lightbox operates on the
 * images the server already rendered (it reads each trigger's <img>), so there
 * is no second image-loading path and the image pipeline is untouched.
 */
import { Image } from 'astro:assets';
import type { GalleryPhoto } from '@/lib/media';
import { galleryCategories, categoryForStem } from '@/lib/gallery';

interface Props {
  photos: GalleryPhoto[];
}

const { photos } = Astro.props;

// `getGalleryPhotos()` exposes only { image, alt }; alt is the filename stem
// with hyphens/underscores turned into spaces. Reconstruct a stem-equivalent
// (spaces -> hyphens) so the Milestone 1 prefix matcher can classify it,
// without touching the Phase 3B media contract. (Only category classification
// uses this; the M3 lightbox does NOT parse alt text.)
const items = photos.map((p) => ({
  ...p,
  category: categoryForStem(p.alt.replace(/\s+/g, '-')),
}));
---

{
  items.length === 0 ? (
    <div class="mt-8 rounded-2xl border border-dashed border-black/10 p-10 text-center">
      <p class="text-ink-soft">
        Optimized gallery images will be added here, each with a descriptive
        filename, dimensions and alt text.
      </p>
    </div>
  ) : (
    <div data-gallery>
      <div
        class="flex flex-wrap gap-2"
        role="group"
        aria-label="Filter gallery by category"
      >
        {galleryCategories.map((c) => (
          <button
            type="button"
            data-filter={c.slug}
            aria-pressed={c.slug === 'all' ? 'true' : 'false'}
            class="cursor-pointer rounded-full px-4 py-1.5 text-sm font-medium bg-soft text-primary aria-[pressed=true]:bg-primary aria-[pressed=true]:text-white"
          >
            {c.label}
          </button>
        ))}
      </div>

      <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {items.map(({ image, alt, category }) => (
          <div data-category={category}>
            <button
              type="button"
              data-lightbox-trigger
              aria-haspopup="dialog"
              aria-label={`Open image: ${alt}`}
              class="block w-full cursor-pointer rounded-2xl"
            >
              <Image
                src={image}
                alt={alt}
                width={800}
                height={600}
                class="aspect-[4/3] w-full rounded-2xl object-cover shadow-card"
                loading="lazy"
              />
            </button>
          </div>
        ))}
      </div>

      {/* Lightbox: native <dialog> for built-in modal semantics, focus
          containment and Esc-to-close. Present only when images exist. */}
      <dialog
        data-lightbox
        aria-label="Gallery image viewer"
        class="m-auto max-h-[92vh] max-w-[92vw] rounded-2xl border-0 bg-white p-0 shadow-card backdrop:bg-black/80"
      >
        <div class="relative">
          <img
            data-lightbox-image
            src=""
            alt=""
            class="block max-h-[85vh] max-w-full rounded-2xl object-contain"
          />
          <button
            type="button"
            data-lightbox-prev
            aria-label="Previous image"
            class="absolute left-2 top-1/2 -translate-y-1/2 grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-white/90 text-2xl font-bold text-ink shadow-card disabled:cursor-default disabled:opacity-40"
          >
            <span aria-hidden="true">&lsaquo;</span>
          </button>
          <button
            type="button"
            data-lightbox-next
            aria-label="Next image"
            class="absolute right-2 top-1/2 -translate-y-1/2 grid h-11 w-11 cursor-pointer place-items-center rounded-full bg-white/90 text-2xl font-bold text-ink shadow-card disabled:cursor-default disabled:opacity-40"
          >
            <span aria-hidden="true">&rsaquo;</span>
          </button>
          <button
            type="button"
            data-lightbox-close
            aria-label="Close image viewer"
            class="absolute right-2 top-2 grid h-10 w-10 cursor-pointer place-items-center rounded-full bg-white/90 text-xl font-bold text-ink shadow-card"
          >
            <span aria-hidden="true">&times;</span>
          </button>
        </div>
      </dialog>
    </div>
  )
}

<script>
  // Progressive enhancement. Without this script every image is visible, the
  // filter buttons are inert, and the image triggers are plain buttons that do
  // nothing — the gallery stays fully usable.
  const root = document.querySelector<HTMLElement>('[data-gallery]');
  if (root) {
    /* ---- Filtering (Milestone 2) ---- */
    const filterButtons = Array.from(
      root.querySelectorAll<HTMLButtonElement>('button[data-filter]')
    );
    const cells = Array.from(
      root.querySelectorAll<HTMLElement>('[data-category]')
    );

    const applyFilter = (active: string) => {
      for (const cell of cells) {
        const match = active === 'all' || cell.dataset.category === active;
        cell.hidden = !match;
      }
      for (const btn of filterButtons) {
        btn.setAttribute('aria-pressed', String(btn.dataset.filter === active));
      }
    };

    for (const btn of filterButtons) {
      btn.addEventListener('click', () =>
        applyFilter(btn.dataset.filter ?? 'all')
      );
    }

    /* ---- Lightbox (Milestone 3) ---- */
    const dialog = root.querySelector<HTMLDialogElement>('dialog[data-lightbox]');
    const triggers = Array.from(
      root.querySelectorAll<HTMLButtonElement>('button[data-lightbox-trigger]')
    );

    if (dialog && triggers.length && typeof dialog.showModal === 'function') {
      const dialogImage = dialog.querySelector<HTMLImageElement>(
        '[data-lightbox-image]'
      )!;
      const prevBtn = dialog.querySelector<HTMLButtonElement>(
        '[data-lightbox-prev]'
      )!;
      const nextBtn = dialog.querySelector<HTMLButtonElement>(
        '[data-lightbox-next]'
      )!;
      const closeBtn = dialog.querySelector<HTMLButtonElement>(
        '[data-lightbox-close]'
      )!;

      // The navigation set is the currently VISIBLE triggers, computed at open
      // time from DOM visibility — never from alt text or category strings —
      // so previous/next respect the active filter and never reach a hidden
      // image.
      let navSet: HTMLButtonElement[] = [];
      let index = 0;
      let lastFocused: HTMLElement | null = null;

      const isVisible = (t: HTMLButtonElement) =>
        !t.closest<HTMLElement>('[data-category]')?.hidden;

      const render = () => {
        const trigger = navSet[index];
        const img = trigger?.querySelector('img');
        if (img) {
          dialogImage.src = img.currentSrc || img.src;
          dialogImage.alt = img.alt;
        }
        // Capture focus BEFORE disabling: disabling a focused button blurs it
        // to <body> synchronously, which would drop focus out of the dialog.
        const active = document.activeElement;
        prevBtn.disabled = index <= 0;
        nextBtn.disabled = index >= navSet.length - 1;
        if (
          (active === prevBtn && prevBtn.disabled) ||
          (active === nextBtn && nextBtn.disabled)
        ) {
          closeBtn.focus();
        }
      };

      const open = (trigger: HTMLButtonElement) => {
        navSet = triggers.filter(isVisible);
        index = navSet.indexOf(trigger);
        if (index < 0) return;
        lastFocused = trigger;
        render();
        dialog.showModal();
        closeBtn.focus();
      };

      const go = (delta: number) => {
        const next = index + delta;
        if (next < 0 || next >= navSet.length) return;
        index = next;
        render();
      };

      for (const trigger of triggers) {
        trigger.addEventListener('click', () => open(trigger));
      }

      prevBtn.addEventListener('click', () => go(-1));
      nextBtn.addEventListener('click', () => go(1));
      closeBtn.addEventListener('click', () => dialog.close());

      // Backdrop click (clicks that land on the dialog element itself, i.e.
      // outside the inner content) close the viewer.
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });

      // Arrow-key navigation, without interfering with Esc/Tab (handled
      // natively by <dialog>).
      dialog.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowLeft') {
          e.preventDefault();
          go(-1);
        } else if (e.key === 'ArrowRight') {
          e.preventDefault();
          go(1);
        }
      });

      // Native <dialog> fires 'close' on Esc, close(), and backdrop close.
      // Restore focus explicitly rather than relying on browser behavior.
      dialog.addEventListener('close', () => {
        dialogImage.removeAttribute('src');
        lastFocused?.focus();
        lastFocused = null;
      });
    }
  }
</script>
