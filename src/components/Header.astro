---
import { primaryNav } from '@data/navigation';
import { clinic } from '@data/clinic';
import { whatsappUrl, whatsappMessages } from '@/lib/whatsapp';

const current = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? current === '/' : current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-black/5 bg-white/90 backdrop-blur-md">
  <div class="container-x flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Abhaya Allergy Center home">
      <span class="grid h-9 w-9 place-items-center rounded-lg bg-primary text-lg font-bold text-white">A</span>
      <span class="flex flex-col leading-tight">
        <span class="font-heading text-base font-bold tracking-tight text-primary">ABHAYA</span>
        <span class="hidden text-[10px] uppercase tracking-widest text-ink-soft sm:block">Allergy Center</span>
      </span>
    </a>

    <nav aria-label="Primary" class="hidden lg:block">
      <ul class="flex items-center gap-6">
        {
          primaryNav.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? 'page' : undefined}
                class={`text-sm font-medium transition-colors hover:text-primary ${
                  isActive(link.href) ? 'text-primary' : 'text-ink-soft'
                }`}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="hidden items-center gap-2 lg:flex">
      <a href={`tel:${clinic.phone.tel}`} class="rounded-full bg-soft px-4 py-2 text-xs font-semibold text-primary hover:bg-leaf hover:text-white transition-colors">
        {clinic.phone.display}
      </a>
      <a href={whatsappUrl(whatsappMessages.booking)} target="_blank" rel="noopener noreferrer" class="rounded-full bg-primary px-5 py-2 text-xs font-semibold text-white shadow-sm hover:bg-primary-dark transition-colors">
        Book Consultation
      </a>
    </div>

    <button
      type="button"
      class="lg:hidden grid h-10 w-10 place-items-center rounded-lg text-ink hover:bg-soft"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-open
    >
      <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 6h16M4 12h16M4 18h16" /></svg>
    </button>
  </div>

  {/* Mobile menu */}
  <div id="mobile-menu" class="fixed inset-0 z-50 hidden lg:hidden" data-menu-panel>
    <div class="absolute inset-0 bg-black/50" data-menu-close></div>
    <div class="absolute right-0 top-0 flex h-full w-4/5 max-w-sm flex-col bg-white shadow-2xl">
      <div class="flex items-center justify-between border-b border-black/5 px-5 h-16">
        <span class="font-heading font-bold text-primary">ABHAYA</span>
        <button type="button" class="grid h-10 w-10 place-items-center rounded-lg hover:bg-soft" aria-label="Close menu" data-menu-close>
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
        </button>
      </div>
      <nav aria-label="Mobile" class="flex-1 overflow-y-auto px-5 py-6">
        <ul class="flex flex-col gap-1">
          {
            primaryNav.map((link) => (
              <li>
                <a href={link.href} class="block rounded-lg px-3 py-3 text-base font-medium text-ink hover:bg-soft hover:text-primary">
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="border-t border-black/5 p-5 flex flex-col gap-3">
        <a href={`tel:${clinic.phone.tel}`} class="flex items-center justify-center gap-2 rounded-xl border border-black/10 py-3 font-medium text-ink">Call {clinic.phone.display}</a>
        <a href={whatsappUrl(whatsappMessages.booking)} target="_blank" rel="noopener noreferrer" class="flex items-center justify-center gap-2 rounded-xl bg-[#25D366] py-3 font-medium text-white">WhatsApp</a>
      </div>
    </div>
  </div>
</header>

<script>
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const closers = document.querySelectorAll<HTMLElement>('[data-menu-close]');
  const setOpen = (open: boolean) => {
    if (!panel || !openBtn) return;
    panel.classList.toggle('hidden', !open);
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  openBtn?.addEventListener('click', () => setOpen(true));
  closers.forEach((c) => c.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>
