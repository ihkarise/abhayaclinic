---
import type { Crumb } from '@/lib/schema';

interface Props {
  crumbs: Crumb[];
  class?: string;
}
const { crumbs, class: className = '' } = Astro.props;
---

<nav aria-label="Breadcrumb" class={`text-sm ${className}`}>
  <ol class="flex flex-wrap items-center gap-1.5 text-ink-soft">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-1.5">
          {i < crumbs.length - 1 ? (
            <a href={c.url} class="hover:text-primary transition-colors">
              {c.name}
            </a>
          ) : (
            <span aria-current="page" class="text-ink font-medium">
              {c.name}
            </span>
          )}
          {i < crumbs.length - 1 && (
            <span aria-hidden="true" class="text-ink-soft/50">
              /
            </span>
          )}
        </li>
      ))
    }
  </ol>
</nav>
