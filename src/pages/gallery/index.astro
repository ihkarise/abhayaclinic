---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaBand from '@components/CtaBand.astro';
import GalleryGrid from '@components/GalleryGrid.astro';
import { graph, breadcrumbSchema } from '@/lib/schema';
import { getGalleryPhotos } from '@/lib/media';

const photos = getGalleryPhotos();

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Gallery', url: '/gallery/' },
];
---

<BaseLayout
  title="Gallery"
  description="Photos and allergy-awareness material from Abhaya Allergy Center, Nilambur."
  canonical="/gallery/"
  schema={graph(breadcrumbSchema(crumbs))}
>
  <section class="container-x pt-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6 font-heading text-4xl font-bold sm:text-5xl">Gallery</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Clinic photos and allergy-awareness material.
    </p>
  </section>

  <section class="container-x py-14">
    <GalleryGrid photos={photos} />
  </section>

  <CtaBand />
</BaseLayout>
