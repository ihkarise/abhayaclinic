---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import CtaBand from '@components/CtaBand.astro';
import { graph, breadcrumbSchema } from '@/lib/schema';
import { isPublished } from '@/lib/content';

const conditions = (await getCollection('conditions'))
  .filter(isPublished)
  .sort((a, b) => a.data.order - b.data.order);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Allergy Conditions', url: '/conditions/' },
];
---

<BaseLayout
  title="Allergy Conditions"
  description="Explore the allergy conditions we focus on at Abhaya Allergy Center, Nilambur — allergic rhinitis, sinus allergy, asthma & wheezing, adenoid enlargement, eczema and urticaria."
  canonical="/conditions/"
  schema={graph(breadcrumbSchema(crumbs))}
>
  <PageHeader
    crumbs={crumbs}
    title="Allergy Conditions"
    lead="Understanding your condition is the first step. Select a concern below to learn about its symptoms, common triggers and when to seek help."
  />

  <section class="container-x py-14">
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {
        conditions.map((c) => (
          <a href={`/conditions/${c.id}/`} class="group card card-hover p-6">
            <h2 class="font-heading text-lg font-semibold text-ink group-hover:text-primary">{c.data.title}</h2>
            <p class="mt-2 text-sm text-ink-soft">{c.data.summary}</p>
            <span class="card-more">Learn more →</span>
          </a>
        ))
      }
    </div>
  </section>

  <CtaBand />
</BaseLayout>
