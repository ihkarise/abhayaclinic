---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import CtaBand from '@components/CtaBand.astro';
import { graph, breadcrumbSchema } from '@/lib/schema';
import { isPublished } from '@/lib/content';

export const getStaticPaths = (async () => {
  const conditions = (await getCollection('conditions')).filter(isPublished);
  return conditions.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const all = (await getCollection('conditions')).filter(isPublished);
const related = data.related
  .map((id) => all.find((c) => c.id === id))
  .filter(Boolean);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Conditions', url: '/conditions/' },
  { name: data.title, url: `/conditions/${entry.id}/` },
];

const faqSchema =
  data.faq.length > 0
    ? {
        '@type': 'FAQPage',
        mainEntity: data.faq.map((f) => ({
          '@type': 'Question',
          name: f.question,
          acceptedAnswer: { '@type': 'Answer', text: f.answer },
        })),
      }
    : null;

const schema = faqSchema
  ? graph(breadcrumbSchema(crumbs), faqSchema)
  : graph(breadcrumbSchema(crumbs));
---

<BaseLayout
  title={`${data.title} | Symptoms & Allergy Consultation`}
  description={data.seo?.description ?? data.summary}
  canonical={`/conditions/${entry.id}/`}
  schema={schema}
>
  <article>
    <PageHeader crumbs={crumbs} title={data.title} lead={data.intro} />

    <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_320px]">
      <div class="prose-clinic max-w-none">
        {
          data.symptoms.length > 0 && (
            <>
              <h2>Common symptoms</h2>
              <ul>{data.symptoms.map((s) => <li>{s}</li>)}</ul>
            </>
          )
        }
        {
          data.triggers.length > 0 && (
            <>
              <h2>Common triggers</h2>
              <ul>{data.triggers.map((t) => <li>{t}</li>)}</ul>
            </>
          )
        }
        {data.whoAffected && (<><h2>Who may experience it</h2><p>{data.whoAffected}</p></>)}
        {data.whenToSeekHelp && (<><h2>When symptoms need medical attention</h2><p>{data.whenToSeekHelp}</p></>)}
        {data.consultationApproach && (<><h2>How consultation works</h2><p>{data.consultationApproach}</p></>)}

        <div class="prose-clinic"><Content /></div>

        {
          data.faq.length > 0 && (
            <>
              <h2>Frequently asked questions</h2>
              {data.faq.map((f) => (
                <div class="mb-4">
                  <h3>{f.question}</h3>
                  <p>{f.answer}</p>
                </div>
              ))}
            </>
          )
        }
      </div>

      <aside class="lg:sticky lg:top-24 lg:self-start">
        <div class="card p-6">
          <h2 class="font-heading text-lg font-semibold">Discuss your symptoms</h2>
          <p class="mt-2 text-sm text-ink-soft">Talk to {`Abhaya Allergy Center`} about consultation for {data.title.toLowerCase()}.</p>
          <WhatsAppButton condition={data.title} label="Chat on WhatsApp" class="mt-4 w-full" />
        </div>

        {
          related.length > 0 && (
            <div class="mt-6 rounded-2xl border border-black/5 p-6">
              <h2 class="font-heading text-sm font-semibold uppercase tracking-wide text-ink-soft">Related conditions</h2>
              <ul class="mt-3 space-y-2">
                {related.map((r) => (
                  <li><a href={`/conditions/${r!.id}/`} class="text-sm font-medium text-primary hover:text-primary-dark">{r!.data.title}</a></li>
                ))}
              </ul>
            </div>
          )
        }
      </aside>
    </div>

    <div class="container-x space-y-3">
      {
        /* Show a review line ONLY when review actually happened:
           medicalReviewed AND reviewedBy AND reviewedAt must all be present. */
        data.medicalReviewed && data.reviewedBy && data.reviewedAt && (
          <p class="text-sm text-ink-soft">
            Medically reviewed by {data.reviewedBy} on{' '}
            {data.reviewedAt.toLocaleDateString('en-IN', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}.
          </p>
        )
      }
      <p class="rounded-xl bg-soft/50 px-4 py-3 text-sm text-ink-soft">
        This page provides general information and is not a substitute for
        professional medical advice. Please consult a qualified doctor about
        your individual situation.
      </p>
    </div>
  </article>

  <CtaBand condition={data.title} heading={`Living with ${data.title.toLowerCase()}?`} />
</BaseLayout>
