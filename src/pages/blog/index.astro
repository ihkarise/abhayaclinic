---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import CtaBand from '@components/CtaBand.astro';
import { graph, breadcrumbSchema } from '@/lib/schema';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Health Blog', url: '/blog/' },
];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Health Blog | Allergy Education & Health Information"
  description="Allergy education and health information from Abhaya Allergy Center — practical, readable articles on allergic rhinitis, respiratory and skin health."
  canonical="/blog/"
  schema={graph(breadcrumbSchema(crumbs))}
>
  <section class="container-x pt-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6 font-heading text-4xl font-bold sm:text-5xl">Health Blog</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Practical allergy and health education, written to help you understand your
      symptoms and options.
    </p>
  </section>

  <section class="container-x py-14">
    {
      posts.length === 0 ? (
        <p class="text-ink-soft">New articles are on the way. Please check back soon.</p>
      ) : (
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {posts.map((p) => (
            <article class="flex flex-col rounded-2xl border border-black/5 bg-white p-6 shadow-card">
              <span class="text-xs font-semibold uppercase tracking-wide text-primary">
                <a href={`/blog/category/${p.data.category}/`} class="hover:underline">{p.data.category.replace(/-/g, ' ')}</a>
              </span>
              <h2 class="mt-2 font-heading text-lg font-semibold text-ink">
                <a href={`/blog/${p.id}/`} class="hover:text-primary">{p.data.title}</a>
              </h2>
              <p class="mt-2 flex-1 text-sm text-ink-soft">{p.data.excerpt ?? p.data.description}</p>
              <time datetime={p.data.publishedAt.toISOString()} class="mt-4 text-xs text-ink-soft">{fmt(p.data.publishedAt)}</time>
            </article>
          ))}
        </div>
      )
    }
  </section>

  <CtaBand heading="Have a question about your symptoms?" />
</BaseLayout>
