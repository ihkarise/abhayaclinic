---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import { graph, breadcrumbSchema, articleSchema } from '@/lib/schema';
import { isPublishedPost } from '@/lib/content';

export const getStaticPaths = (async () => {
  const posts = await getCollection('blog');
  return posts
    .filter(isPublishedPost)
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const url = `/blog/${entry.id}/`;

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Health Blog', url: '/blog/' },
  { name: data.title, url },
];

const schema = graph(
  breadcrumbSchema(crumbs),
  articleSchema({
    title: data.title,
    description: data.description,
    url,
    publishedAt: data.publishedAt,
    updatedAt: data.updatedAt,
  })
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonical={data.canonical ?? url}
  ogType="article"
  schema={schema}
>
  <article class="container-x py-12">
    <div class="mx-auto max-w-3xl">
      <Breadcrumbs crumbs={crumbs} />
      <span class="mt-6 inline-flex text-xs font-semibold uppercase tracking-wide text-primary">
        <a href={`/blog/category/${data.category}/`} class="hover:underline">{data.category.replace(/-/g, ' ')}</a>
      </span>
      <h1 class="mt-3 font-heading text-3xl font-bold sm:text-4xl">{data.title}</h1>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
        <span>By {data.author}</span>
        <span aria-hidden="true">·</span>
        <time datetime={data.publishedAt.toISOString()}>{fmt(data.publishedAt)}</time>
        {data.updatedAt && (<><span aria-hidden="true">·</span><span>Updated {fmt(data.updatedAt)}</span></>)}
      </div>
      {
        data.medicalReviewed && data.reviewedBy && (
          <p class="mt-3 rounded-lg bg-soft/50 px-3 py-2 text-sm text-ink-soft">
            Medically reviewed by {data.reviewedBy}
            {data.reviewedAt && ` on ${fmt(data.reviewedAt)}`}.
          </p>
        )
      }

      <div class="prose-clinic mt-8">
        <Content />
      </div>

      <div class="mt-10 rounded-2xl bg-mist p-6">
        <h2 class="font-heading text-lg font-semibold">Talk to the clinic</h2>
        <p class="mt-2 text-sm text-ink-soft">
          If you would like to discuss your symptoms, reach Abhaya Allergy Center
          on WhatsApp for an in-person or online consultation.
        </p>
        <WhatsAppButton context="booking" label="Chat on WhatsApp" class="mt-4" />
      </div>

      <p class="mt-8 text-sm text-ink-soft">
        <strong>Medical disclaimer:</strong> This article is for general
        information only and is not a substitute for professional medical advice.
        Please consult a qualified doctor about your individual situation.
        <a href="/medical-disclaimer/" class="text-primary underline">Read our full disclaimer</a>.
      </p>
    </div>
  </article>
</BaseLayout>
