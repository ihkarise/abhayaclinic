---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import CallButton from '@components/CallButton.astro';
import { clinic } from '@data/clinic';
import { graph, breadcrumbSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Book Consultation', url: '/book-consultation/' },
];
---

<BaseLayout
  title="Book a Consultation"
  description="Book an allergy consultation with Dr Varun Vasudev at Abhaya Allergy Center — in person in Nilambur or online. Book easily on WhatsApp."
  canonical="/book-consultation/"
  schema={graph(breadcrumbSchema(crumbs))}
>
  <section class="container-x pt-10">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-6 font-heading text-4xl font-bold sm:text-5xl">Book a Consultation</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-soft">
      Booking is simple — message us on WhatsApp and we will help you arrange a
      time that suits you, in person or online.
    </p>
  </section>

  <section class="container-x py-14">
    <div class="mx-auto max-w-2xl rounded-3xl border border-black/5 bg-white p-8 text-center shadow-card sm:p-12">
      <h2 class="font-heading text-2xl font-bold">Book on WhatsApp</h2>
      <p class="mt-3 text-ink-soft">
        Tap below to start a conversation. Let us know your symptoms and whether
        you prefer an in-person or online consultation.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <WhatsAppButton context="booking" label="Book on WhatsApp" size="lg" />
        <CallButton variant="outline" />
      </div>
      <p class="mt-6 text-sm text-ink-soft">{clinic.hours.summary}</p>
    </div>

    <div class="mx-auto mt-10 grid max-w-2xl gap-4 sm:grid-cols-3 text-center">
      <a href="/services/in-person-consultation/" class="rounded-xl border border-black/5 p-4 text-sm font-medium text-primary hover:bg-mist">In-person</a>
      <a href="/services/online-consultation/" class="rounded-xl border border-black/5 p-4 text-sm font-medium text-primary hover:bg-mist">Online</a>
      <a href="/services/follow-up-consultation/" class="rounded-xl border border-black/5 p-4 text-sm font-medium text-primary hover:bg-mist">Follow-up</a>
    </div>
  </section>
</BaseLayout>
