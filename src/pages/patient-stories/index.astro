---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import CtaBand from '@components/CtaBand.astro';
import { graph, breadcrumbSchema } from '@/lib/schema';
import { isPublished } from '@/lib/content';

// Render only stories that are published (status), not draft, AND consented.
const stories = (await getCollection('patientStories')).filter(
  (s) => isPublished(s) && !s.data.draft && s.data.consentObtained
);

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'Patient Stories', url: '/patient-stories/' },
];
---

<BaseLayout
  title="Patient Stories"
  description="Read patient experiences shared with consent at Abhaya Allergy Center, Nilambur."
  canonical="/patient-stories/"
  schema={graph(breadcrumbSchema(crumbs))}
>
  <PageHeader
    crumbs={crumbs}
    title="Patient Stories"
    lead="Experiences shared by patients, published only with their consent."
  />

  <section class="container-x py-14">
    {
      stories.length === 0 ? (
        <div class="rounded-2xl border border-dashed border-black/10 p-10 text-center">
          <p class="text-ink-soft">
            Verified, consent-approved patient stories will appear here. We do
            not publish testimonials without the patient's permission.
          </p>
        </div>
      ) : (
        <div class="grid gap-6 md:grid-cols-2">
          {stories.map((s) => (
            <blockquote class="card p-6">
              <p class="text-ink-soft">{s.data.summary}</p>
              {s.data.conditionLabel && (
                <footer class="mt-3 text-sm font-medium text-primary">{s.data.conditionLabel}</footer>
              )}
            </blockquote>
          ))}
        </div>
      )
    }
  </section>

  <CtaBand />
</BaseLayout>
