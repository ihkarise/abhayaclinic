---
import { Image } from 'astro:assets';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/PageHeader.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import CtaBand from '@components/CtaBand.astro';
import { doctor } from '@data/doctor';
import { graph, breadcrumbSchema, physicianSchema } from '@/lib/schema';
import { getPhoto } from '@/lib/media';

const portrait = getPhoto('doctor-portrait');

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
  { name: doctor.name, url: '/about/dr-varun-vasudev/' },
];

// Render only fields that carry verified information. Missing fields produce
// no heading — see docs/DOCTOR-CONTENT-VERIFICATION.md.
const primaryQual = doctor.qualifications[0];
const subtitle = [primaryQual?.degree, 'Allergy-focused consultation']
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout
  title={doctor.name}
  description={`${doctor.name}, ${primaryQual?.degree ?? ''} — allergy-focused consultation at Abhaya Allergy Center, Nilambur. In-person and online consultations.`}
  canonical="/about/dr-varun-vasudev/"
  schema={graph(breadcrumbSchema(crumbs), physicianSchema())}
>
  <PageHeader crumbs={crumbs} title={doctor.name} lead={subtitle} />

  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_320px]">
    <div class="prose-clinic max-w-none">
      <h2>Professional introduction</h2>
      <p>{doctor.professionalBio}</p>

      {
        doctor.qualifications.length > 0 && (
          <>
            <h2>Qualifications</h2>
            <ul>
              {doctor.qualifications.map((q) => (
                <li>
                  {q.degree} — {q.institution}
                  {q.year ? ` (${q.year})` : ''}
                </li>
              ))}
            </ul>
          </>
        )
      }

      {doctor.registration && (<><h2>Registration</h2><p>{doctor.registration}</p></>)}
      {doctor.experience && (<><h2>Experience</h2><p>{doctor.experience}</p></>)}

      {
        doctor.areasOfFocus.length > 0 && (
          <>
            <h2>Areas of focus</h2>
            <ul>{doctor.areasOfFocus.map((a) => <li>{a}</li>)}</ul>
          </>
        )
      }

      {doctor.consultationApproach && (<><h2>Approach to consultation</h2><p>{doctor.consultationApproach}</p></>)}
      {doctor.healthEducation && (<><h2>Health education</h2><p>{doctor.healthEducation}</p></>)}

      <p class="text-sm">
        <em>Registration details and any further qualifications or memberships
        will be added here once verified.</em>
      </p>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      {
        portrait && (
          <Image
            src={portrait}
            alt={doctor.name}
            width={640}
            height={640}
            class="mb-6 aspect-square w-full rounded-2xl object-cover shadow-card"
            loading="lazy"
          />
        )
      }
      <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-card">
        <h2 class="font-heading text-lg font-semibold">Book a consultation</h2>
        <p class="mt-2 text-sm text-ink-soft">In person or online — message us on WhatsApp.</p>
        <WhatsAppButton context="booking" label="Chat on WhatsApp" class="mt-4 w-full" />
      </div>
    </aside>
  </div>

  <CtaBand />
</BaseLayout>
