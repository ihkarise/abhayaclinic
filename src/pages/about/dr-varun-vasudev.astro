---
import BaseLayout from '@layouts/BaseLayout.astro';
import Breadcrumbs from '@components/Breadcrumbs.astro';
import WhatsAppButton from '@components/WhatsAppButton.astro';
import CtaBand from '@components/CtaBand.astro';
import { clinic } from '@data/clinic';
import { graph, breadcrumbSchema, physicianSchema } from '@/lib/schema';

const crumbs = [
  { name: 'Home', url: '/' },
  { name: 'About', url: '/about/' },
  { name: clinic.doctor, url: '/about/dr-varun-vasudev/' },
];
---

<BaseLayout
  title={`${clinic.doctor}`}
  description={`${clinic.doctor}, BHMS — allergy-focused consultation at Abhaya Allergy Center, Nilambur. In-person and online consultations.`}
  canonical="/about/dr-varun-vasudev/"
  schema={graph(breadcrumbSchema(crumbs), physicianSchema())}
>
  <header class="bg-mist">
    <div class="container-x py-12">
      <Breadcrumbs crumbs={crumbs} />
      <h1 class="mt-6 font-heading text-4xl font-bold sm:text-5xl">{clinic.doctor}</h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">BHMS · Allergy-focused consultation &amp; health education</p>
    </div>
  </header>

  <div class="container-x grid gap-12 py-14 lg:grid-cols-[1fr_320px]">
    <div class="prose-clinic max-w-none">
      <h2>Professional introduction</h2>
      <p>
        {clinic.doctor} completed his BHMS from Martin Homoeopathic Medical
        College, Coimbatore, and is a third-generation doctor. He consults with
        patients both in person at the clinic in Nilambur and online.
      </p>

      <h2>Qualifications</h2>
      <ul>
        <li>BHMS — Martin Homoeopathic Medical College, Coimbatore</li>
      </ul>
      <p class="text-sm">
        <em>Further qualifications, registration details and professional
        memberships will be added once verified.</em>
      </p>

      <h2>Areas of focus</h2>
      <p>
        Allergy-related concerns including allergic rhinitis, sinus allergy,
        asthma and wheezing, adenoid enlargement, eczema and urticaria.
      </p>

      <h2>Approach to consultation</h2>
      <p>
        Each consultation begins by understanding your symptoms, history and
        likely triggers, so that guidance can be tailored to your individual
        situation. {clinic.doctor} also offers counselling and health guidance
        as part of whole-person care.
      </p>

      <h2>Health education</h2>
      <p>
        {clinic.doctor} has a long-standing interest in health education —
        sharing health information through articles and social media, and
        conducting health awareness sessions in the community.
      </p>
    </div>

    <aside class="lg:sticky lg:top-24 lg:self-start">
      <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-card">
        <h2 class="font-heading text-lg font-semibold">Book a consultation</h2>
        <p class="mt-2 text-sm text-ink-soft">In person or online — message us on WhatsApp.</p>
        <WhatsAppButton context="booking" label="Chat on WhatsApp" class="mt-4 w-full" />
      </div>
    </aside>
  </div>

  <CtaBand />
</BaseLayout>
